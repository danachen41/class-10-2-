rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/tasks/{taskId} {
      function ownsTask() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validTask() {
        return request.resource.data.keys().hasOnly([
            'id', 'title', 'desc', 'dueDate', 'priority', 'completed', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'title', 'desc', 'dueDate', 'priority', 'completed', 'createdAt'
          ])
          && request.resource.data.id == taskId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.desc is string
          && request.resource.data.desc.size() <= 500
          && request.resource.data.dueDate is string
          && request.resource.data.priority in ['High', 'Medium', 'Low']
          && request.resource.data.completed is bool
          && request.resource.data.createdAt is number;
      }

      allow get, list: if ownsTask();
      allow create, update: if ownsTask() && validTask();
      allow delete: if ownsTask();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

